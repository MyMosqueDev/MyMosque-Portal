# Local Prisma preview DB (provisioned by `prisma dev`)
DATABASE_URL="postgres://postgres:postgres@localhost:PORT/template1?sslmode=disable"
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:PORT/template1?sslmode=disable"

# Supabase — https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
