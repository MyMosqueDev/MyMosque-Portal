// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model Mosque {
  id               String         @id @default(uuid())
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  name             String
  address          String
  images           String[]
  hours            Json
  lastAnnouncement DateTime
  lastEvent        DateTime
  lastPrayerTime   DateTime
  coordinates      Json
  jummahTimes      Json
  uid              String
  email            String
  contactInfo      Json

  announcements Announcement[]
  events        Event[]
  prayerTimes   PrayerTime[]
}

model Announcement {
  id          Int       @id @default(autoincrement())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt
  mosqueId    String
  mosque      Mosque    @relation(fields: [mosqueId], references: [id])
  title       String
  description String
  severity    Severity    @default(medium)
  status      Status    @default(published)
  image       String?
}

model Event {
  id          Int       @id @default(autoincrement())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt
  mosqueId    String
  mosque      Mosque    @relation(fields: [mosqueId], references: [id])
  title       String
  description String
  date        DateTime
  host        String
  location    String
  image       String
  status      Status    @default(published)
}

model PrayerTime {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  mmYy        String
  mosqueId    String
  mosque      Mosque   @relation(fields: [mosqueId], references: [id])
  prayerTimes Json
}


// ENUMS
enum Severity {
  low
  medium
  high
}

enum Status {
  published
  draft
  deleted
}

